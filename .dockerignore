# Keep secrets, local state and bulky dirs out of the image. data/, models/ and configs/ are
# mounted at run time (docker-compose.yml), so the image never holds results or keys.
.git
.github
.env
.env.*
!.env.example
.venv
venv
data
models
runs
docs
tests
.benchmarks
.pytest_cache
.ruff_cache
.mypy_cache
**/__pycache__
**/*.pyc
*.cmd
condaenv.*
