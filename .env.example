# Copy to .env - never commit .env
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000
METRICS_DB_URL=sqlite:///./data/metrics.db

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLMGateway (open decision 13.1): "ollama" or "openai"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
TIER2_MODEL=llama3.2:3b
# Judge (offline only): Gemini via its OpenAI-compatible endpoint
JUDGE_MODEL=gemini-2.5-flash
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=

# AMIC (design defaults, to be validated)
AMIC_LAMBDA=4.0
