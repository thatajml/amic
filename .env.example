# Copy to .env (never commit it) and set what you need. Everything except GEMINI_API_KEY is
# optional: the commented values are the defaults from src/amic/contracts/config.py.
# The app reads only AMIC_* names; nested settings use "__" (AMIC_MODELS__TUTOR = models.tutor).

# Judge (offline evaluation only): Gemini via its OpenAI-compatible endpoint
GEMINI_API_KEY=
# AMIC_MODELS__JUDGE=gemini-3.5-flash-lite
# AMIC_MODELS__JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Tutor LLM (always served by Ollama) and embeddings
# AMIC_MODELS__OLLAMA_BASE_URL=http://localhost:11434
# AMIC_MODELS__TUTOR=llama3.1:8b
# AMIC_MODELS__TIER2=llama3.2:3b
# AMIC_MODELS__EMBEDDING=sentence-transformers/all-MiniLM-L6-v2

# Gate: cost ratio C(false skip) / C(false retrieve)
# AMIC_GATE__LAM=4.0

# Session store: "redis" (default, needs Docker) or "sqlite" (no Docker)
# AMIC_SESSION_BACKEND=redis
# AMIC_REDIS_URL=redis://localhost:6379/0
# Chroma: "embedded" (default, files in data/chroma) or "http" (the Docker Chroma server)
# AMIC_CHROMA_CLIENT=embedded
# AMIC_CHROMA_HOST=localhost
# AMIC_CHROMA_PORT=8000
# AMIC_METRICS_DB_URL=sqlite:///./data/metrics.db

# Live dashboard: measure the always-retrieve baseline after each API response
# AMIC_TELEMETRY__SHADOW_BASELINE=false

# Python environment for start-amic.cmd / chat-amic.cmd: venv, conda or auto (.venv if present,
# else the conda env). setup-amic.cmd sets this. AMIC_PYTHON=<path> overrides both.
# AMIC_ENV=auto
# AMIC_CONDA_ENV=amic
